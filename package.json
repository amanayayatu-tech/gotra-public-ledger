{
  "name": "gotra-public-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc -b && vite build && npm run geo:generate",
    "lint": "eslint .",
    "test": "vitest run",
    "geo:generate": "node scripts/generate-geo-pages.mjs",
    "geo:smoke": "node scripts/geo-smoke.mjs",
    "reader-brief:generate": "node scripts/generate-daily-reader-brief.mjs",
    "generate:og": "node scripts/generate-og-image.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "dataset:diff": "node scripts/diff-dataset.mjs",
    "resolve:outcomes": "node scripts/resolve-outcomes.mjs --check",
    "portfolio:build": "node scripts/build-paper-portfolio.mjs",
    "pages:preview": "node scripts/pages-preview.mjs",
    "launch:smoke": "node scripts/launch-smoke.mjs",
    "compliance:scan": "node scripts/check-compliance.mjs",
    "secrets:scan": "node scripts/check-secrets.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "lighthouse": "^13.4.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  }
}
